# ==========================================
# ONEVOO PLATFORM — ENVIRONMENT EXAMPLE
# ==========================================

# ------------------------------------------
# 1. Neon Serverless PostgreSQL Database
# (Obtain connection string from https://console.neon.tech)
# ------------------------------------------
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.neon.tech/neondb?channel_binding=require&sslmode=require"
NEON_BRANCH="production"

# ------------------------------------------
# 2. Express Backend Server Configuration
# ------------------------------------------
PORT=3001
JWT_SECRET="onevoo-production-jwt-secret-key-change-this"

# ------------------------------------------
# 3. Cloudinary Media Storage Configuration
# ------------------------------------------
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_URL=""
